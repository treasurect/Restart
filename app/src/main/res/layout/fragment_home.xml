<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/ivHomeChat"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/action_publish"
            android:src="@drawable/ic_chat_bubble" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvHomeFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:text="关注"
                android:textColor="@color/text_tertiary"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvHomeDiscover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:text="发现"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvHomeQingdao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="青岛"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivHomeSearch"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/action_search"
            android:src="@drawable/ic_search" />
    </FrameLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/homeCategoryTabs"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/white"
        app:tabIndicatorColor="@color/xhs_red"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/bg_avatar"
        app:tabSelectedTextColor="@color/xhs_red"
        app:tabTextColor="@color/text_primary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeCategoryPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
