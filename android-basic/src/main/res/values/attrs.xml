<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="SearchTitleBar">
        <attr name="titleText" format="string" />
        <attr name="searchHint" format="string" />
        <attr name="backIcon" format="reference" />
        <attr name="searchIcon" format="reference" />
    </declare-styleable>
    <declare-styleable name="ToolbarView">
        <attr name="tb_title" format="string" />
        <attr name="tb_showBack" format="boolean" />
        <attr name="tb_rightIcon" format="reference" />
        <attr name="tb_showExport" format="boolean" />
        <attr name="tb_showSave" format="boolean" />
        <attr name="tb_showCancel" format="boolean" />
        <attr name="tb_showSearch" format="boolean" />
        <attr name="tb_searchHint" format="string" />
    </declare-styleable>
    <declare-styleable name="InputBoxView">
        <!--绘制类型,目前有三种，线，矩形，圆角-->
        <attr name="input_canvas_type" format="enum">
            <enum name="line" value="0" />
            <enum name="rect" value="1" />
            <enum name="round" value="2" />
        </attr>
        <!--绘制画笔类型，空心还是实心-->
        <attr name="input_canvas_style" format="enum">
            <enum name="stroke" value="0" />
            <enum name="fill" value="1" />
            <enum name="fill_and_stroke" value="2" />
        </attr>
        <!--输入框的背景-->
        <attr name="input_background" format="color" />
        <!--输入框的选择背景-->
        <attr name="input_select_background" format="color" />
        <!--输入框圆角度数-->
        <attr name="input_radius" format="dimension" />
        <!--输入框下划线的高度-->
        <attr name="input_line_height" format="dimension" />
        <!--输入框的长度-->
        <attr name="input_length" format="integer" />
        <!--输入框的间距-->
        <attr name="input_spacing" format="dimension" />
        <!--输入框的内容颜色-->
        <attr name="input_text_color" format="color" />
        <!--输入框的文字大小-->
        <attr name="input_text_size" format="dimension" />
        <!--输入框的文字类型-->
        <attr name="input_text_type" format="enum">
            <enum name="text" value="0" />
            <enum name="asterisk" value="1" />
            <enum name="round" value="2" />
        </attr>
        <!--输入框是否有光标-->
        <attr name="input_is_cursor" format="boolean" />
        <!--输入框光标方向-->
        <attr name="input_cursor_direction" format="boolean" />
        <!--输入框光标宽度-->
        <attr name="input_cursor_width" format="dimension" />
        <!--输入框光标颜色-->
        <attr name="input_cursor_color" format="color" />
        <!--输入框光标间距-->
        <attr name="input_cursor_spacing" format="color" />
        <!--输入框的光标是否闪烁-->
        <attr name="input_cursor_is_twinkle" format="boolean" />
        <!--输入框是否弹起原生的软件盘-->
        <attr name="input_is_android_keyboard" format="boolean" />
        <!--横向的光标距离底部的距离-->
        <attr name="input_cursor_margin_bottom" format="dimension" />


    </declare-styleable>

    <declare-styleable name="ClearEditText">
        <attr name="clearIcon" format="reference" />
        <attr name="clearButtonMode">
            <enum name="always" value="0" />
            <enum name="whileEditing" value="1" />
            <enum name="never" value="2" />
        </attr>
        <!-- 清除按钮的 padding -->
        <attr name="clearIconPadding" format="dimension" />
        <!-- 输入框的 hint 颜色 -->
        <attr name="hintColor" format="color" />
    </declare-styleable>
    <declare-styleable name="SearchEditText">
        <attr name="edit_hint" format="string" />
        <attr name="icon_visibility" format="boolean"/>
        <attr name="cancel_visible" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="BoldTextView">
        <attr name="stroke_width" format="float"/>
    </declare-styleable>

    <declare-styleable name="CollapsibleTagLayout">
        <attr name="default_bg_type" format="integer"/>
    </declare-styleable>
</resources>