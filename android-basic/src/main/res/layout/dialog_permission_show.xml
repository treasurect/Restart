<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/imagecode">
    <TextView
        android:id="@+id/dia_text_msg"
        android:layout_width="0dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:layout_marginTop="10dp"
        android:textColor="#111A34"
        app:layout_constraintBottom_toBottomOf="@id/hline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@+id/sline"
        android:layout_width="1dp"
        android:layout_height="51dp"
        android:background="#1A000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <View
        android:id="@+id/hline"
        android:layout_width="match_parent"
        android:layout_marginTop="108dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="1dp"
        android:background="#1A000000"
        app:layout_constraintBottom_toTopOf="@+id/sline" />

    <Button
        android:id="@+id/dia_cancle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="取消"
        android:textColor="#FF666666"
        android:textSize="16dp"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/sline"
        app:layout_constraintTop_toBottomOf="@id/hline" />

    <Button
        android:id="@+id/dia_confirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#00000000"
        android:text="确定"
        android:textColor="#FF236EED"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/sline"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hline" />
</androidx.constraintlayout.widget.ConstraintLayout>